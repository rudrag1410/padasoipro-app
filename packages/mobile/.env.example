# Where the app finds the API. Leave unset in development: the app uses the same machine
# that serves the Expo bundle (works for simulators, emulators and phones on the same Wi-Fi).
# Set it for APK builds, e.g. http://192.168.1.20:4000 (your computer's LAN IP) or a deployed URL.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# Dev/review only: shows a "Skip verification" button on the OTP screen that submits this code.
# Must match OTP_BYPASS_CODE on the API, and only works there if that's set too. Leave unset normally.
# EXPO_PUBLIC_OTP_BYPASS_CODE=000000
