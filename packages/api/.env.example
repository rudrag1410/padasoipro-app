# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (Expo web runs on 8081). Native apps are not affected by CORS.
CORS_ORIGINS=http://localhost:8081

# ---- Database (SQLite file, created on first start) ----
DATABASE_PATH=./data/padosipro.db

# ---- Security ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=604800
OTP_HASH_SECRET=replace-with-another-long-random-string-32-chars
BCRYPT_COST=12
# Max requests per IP to /auth/* per 15 minutes
AUTH_RATE_LIMIT_MAX=50

# ---- Email ----
# smtp: send through SMTP (Mailpit by default, UI at http://localhost:8025)
# console: print the email (and OTP) to the API logs instead
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PadosiPro <no-reply@padosipro.test>"
